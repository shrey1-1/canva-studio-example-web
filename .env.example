# Copy to .env (gitignored) only if you need to change a default.

# PostgreSQL connection string. Leave unset to use the embedded database in apps/server/data/db.
# DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/canvas_studio

# Server address. `npm start` serves the whole app here; use HOST=0.0.0.0 to allow other machines.
# PORT=8787
# HOST=127.0.0.1

# Set to true when the app is served over HTTPS.
# SECURE_COOKIES=false

# Sign-in / sign-up attempts allowed per 15 minutes per client.
# AUTH_ATTEMPTS=10
